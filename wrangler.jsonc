{
  "name": "our-home-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "our-home-applications",
      "database_id": "744006cb-ab40-4318-8d1a-06ac1a5382ff"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "our-home-application-pdfs"
    }
  ],
  "vars": {
    /* Comma-separated allowlist of admin emails, checked server-side as a
       backup to Cloudflare Access (see src/lib/access.js). Set this to the
       same two emails used in the Access policy. */
    "ADMIN_EMAILS": "admin@structurecollective.com,ellenatourhome@aol.com",
    /* Must be an email address on a domain verified in your Resend account,
       e.g. "Our Home <hiring@ourhomenc.com>". */
    "FROM_EMAIL": "Our Home <hiring@ourhomenc.com>"
  },
  "observability": {
    "enabled": true
  }
}

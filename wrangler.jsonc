{
  "name": "our-home-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "our-home-applications",
      "database_id": "744006cb-ab40-4318-8d1a-06ac1a5382ff"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "our-home-application-pdfs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
